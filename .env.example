# KinnyCode — Memory System Configuration

# Memory Server (FastAPI + LanceDB)
MEMORY_SERVER_HOST=127.0.0.1
MEMORY_SERVER_PORT=8005
MEMORY_SERVER_URL=http://127.0.0.1:8005

# LanceDB storage path (embedded, local disk)
LANCEDB_PATH=./lancedb_memory_db

# Embedding model (CPU-only, dimension 384)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Working memory TTL (seconds)
WORKING_MEMORY_TTL=900

# Ebbinghaus decay constant (days)
MSCORE_LAMBDA_DAYS=30.0

# Optional: PostgreSQL MCP connection (if using Postgres backend)
# POSTGRES_URL=postgresql://localhost:5432/sgcnmdb
